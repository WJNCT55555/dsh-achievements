{
  "name": "@wjnct55555/dsh-achievements",
  "description": "Global achievements engine for the DeepSeek Harness: event-driven counters, one-shot unlock queue, and a read-only list_achievements tool",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJNCT55555/dsh-achievements.git",
    "directory": "packages/extensions/achievements"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "achievements",
    "gamification"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/cordis-plugin-loader": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-command-feedback": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-compaction": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-goal": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-plan-mode": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-schedule": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session-title": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-workflow": ">=0.1.0-rc.5"
  }
}
